rules_version = '2';

// Reglas del Circo del Terror (proyecto Firebase "halloween2026-cfb37").
// Se publican con un comando, no a mano por la consola:
//
//   firebase deploy --only firestore:rules
//
// Requiere el proveedor "Google" habilitado en Authentication.
//
// El principio que ordena todo esto: **un voto secreto no es secreto si el
// votante puede leer los votos**. Por eso las votaciones sensibles (disfraces,
// mentiras) solo las lee el anfitrión, que publica el resultado al cerrarlas.
// Las que no necesitan secreto (menú, película) son de lectura pública y se
// cuentan en el cliente.

service cloud.firestore {
  match /databases/{database}/documents {

    // Ojo: este correo también está en src/lib/event-config.ts. Las reglas no
    // pueden importar del código, así que si cambia hay que tocar ambos lados.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'joseluismunozzuta@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    function miIdentidad() {
      return get(/databases/$(database)/documents/identidades/$(request.auth.uid)).data;
    }

    function tengoIdentidad() {
      return signedIn()
        && exists(/databases/$(database)/documents/identidades/$(request.auth.uid));
    }

    function estado() {
      return get(/databases/$(database)/documents/party/live).data;
    }

    function actividadAbierta(nombre) {
      return estado().actividadAbierta == nombre;
    }

    // ── Estado de la noche ────────────────────────────────────────────────
    // Qué bloque va y qué dinámica está abierta. Todos lo leen; solo el
    // anfitrión lo mueve.
    match /party/live {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Quién es quién ────────────────────────────────────────────────────
    // Lectura pública: el marcador y las parejas muestran nombres reales, no
    // correos. Cada quien escribe solo SU documento, y una sola vez.
    match /identidades/{uid} {
      allow read: if true;

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.persona is string
        && request.resource.data.parejaId is string
        && request.resource.data.keys().hasOnly(
             ['persona', 'parejaId', 'nombre', 'photoURL', 'creadoEn']
           );

      // Nadie cambia de identidad después. Si alguien se equivoca, el
      // anfitrión borra y vuelve a empezar.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // El candado que impide que dos cuentas tomen el mismo nombre. El id del
    // documento ES el nombre, así la transacción de reclamo puede comprobarlo
    // sin consultar la colección (algo que una transacción no permite).
    match /identidadesTomadas/{persona} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Menú colaborativo ─────────────────────────────────────────────────
    // Sin secreto: es un menú. Los votos son públicos y se cuentan en el
    // cliente, lo que ahorra un paso manual al anfitrión.
    match /platos/{platoId} {
      allow read: if true;

      allow create: if tengoIdentidad()
        && request.resource.data.propuestoPor == miIdentidad().persona
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() < 160
        && request.resource.data.tipo in ['cocinar', 'traer']
        && request.resource.data.keys().hasOnly(
             ['titulo', 'tipo', 'propuestoPor', 'asignadoA', 'creadoEn']
           );

      // Quien lo propuso puede corregir el texto; solo el anfitrión asigna.
      allow update: if isAdmin()
        || (tengoIdentidad()
            && resource.data.propuestoPor == miIdentidad().persona
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['titulo', 'tipo']));

      allow delete: if isAdmin()
        || (tengoIdentidad() && resource.data.propuestoPor == miIdentidad().persona);
    }

    match /platoVotos/{votoId} {
      allow read: if true;

      // El id fija un voto por plato y por persona, y que sea el tuyo.
      allow create: if tengoIdentidad()
        && votoId == request.resource.data.platoId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['platoId', 'persona', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.persona == miIdentidad().persona;

      allow update: if false;
      // Retirar el voto propio sí se permite: es un menú, no una urna.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Concurso de disfraces ─────────────────────────────────────────────
    // Una foto por pareja. Cualquiera de los dos la sube o la reemplaza.
    match /disfraces/{parejaId} {
      allow read: if true;

      allow create, update: if tengoIdentidad()
        && miIdentidad().parejaId == parejaId
        && request.resource.data.foto is string
        && request.resource.data.foto.size() < 950000
        && request.resource.data.keys().hasOnly(['foto', 'subidaPor', 'subidaEn']);

      allow delete: if isAdmin();
    }

    // Voto SECRETO: solo el anfitrión los lee. Si el votante pudiera leerlos,
    // el concurso dejaría de tener gracia a los diez segundos.
    match /disfrazVotos/{votoId} {
      allow read: if isAdmin();

      allow create: if tengoIdentidad()
        && votoId == request.auth.uid + '_' + request.resource.data.categoria
        && request.resource.data.keys().hasOnly(['categoria', 'parejaId'])
        // Nadie vota a su propia pareja.
        && request.resource.data.parejaId != miIdentidad().parejaId;

      allow update, delete: if isAdmin();
    }

    // ── Dos verdades y una mentira ────────────────────────────────────────
    // Las frases se escriben antes del evento y nadie más las ve hasta que la
    // dinámica se abre: ahí pasan a ser públicas porque van en la pantalla.
    match /fichas/{persona} {
      allow read: if isAdmin()
        || actividadAbierta('mentiras')
        || (tengoIdentidad() && miIdentidad().persona == persona);

      // Solo tú escribes la tuya, y solo mientras la ronda no haya empezado.
      allow create, update: if tengoIdentidad()
        && miIdentidad().persona == persona
        && !actividadAbierta('mentiras')
        && request.resource.data.frases.size() == 3
        && request.resource.data.keys().hasOnly(['frases', 'actualizadoEn']);

      allow delete: if isAdmin();
    }

    // Marcador público y vacío: dice QUIÉN ya dejó sus frases, sin revelar
    // ninguna. Sin esto el contador de "faltan cuatro" sería imposible, porque
    // antes de abrir la ronda cada quien solo puede leer su propia ficha.
    match /fichasListas/{persona} {
      allow read: if true;
      allow create, update: if tengoIdentidad()
        && miIdentidad().persona == persona
        && request.resource.data.keys().hasOnly([]);
      allow delete: if isAdmin();
    }

    // Cuál de las tres es la mentira. Aislada igual que triviaKeys: la escribe
    // su dueño, la lee solo el anfitrión al momento de revelar.
    match /fichaClaves/{persona} {
      allow read: if isAdmin();

      allow create, update: if tengoIdentidad()
        && miIdentidad().persona == persona
        && !actividadAbierta('mentiras')
        && request.resource.data.indiceMentira is int
        && request.resource.data.indiceMentira >= 0
        && request.resource.data.indiceMentira < 3
        && request.resource.data.keys().hasOnly(['indiceMentira']);

      allow delete: if isAdmin();
    }

    match /mentiraVotos/{votoId} {
      allow read: if isAdmin();

      allow create: if tengoIdentidad()
        && votoId == request.resource.data.ronda + '_' + request.auth.uid
        && actividadAbierta('mentiras')
        && request.resource.data.indice is int
        && request.resource.data.indice >= 0
        && request.resource.data.indice < 3
        && request.resource.data.keys().hasOnly(['ronda', 'indice'])
        // Nadie vota su propia ficha.
        && request.resource.data.ronda != miIdentidad().persona;

      allow update, delete: if isAdmin();
    }

    // ── Película de cierre ────────────────────────────────────────────────
    // Sin secreto: es para decidir qué se pone a las 2 am.
    match /peliculas/{peliculaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /peliculaVotos/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['peliculaId']);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // ── Marcador de Almas ─────────────────────────────────────────────────
    // Lectura pública (se ve en la TV y en cada celular); lo escribe solo el
    // anfitrión, porque los puntos los calcula su panel.
    match /almas/{persona} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Misiones secretas ─────────────────────────────────────────────────
    match /bancoMisiones/{misionId} {
      allow read: if true;
      // Solo se toca 'tomada' al asignar, desde la transacción del cliente.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tomada'])
        && request.resource.data.tomada is bool;
      allow create, delete: if isAdmin();
    }

    match /misiones/{persona} {
      // La tuya y la de nadie más, hasta que el anfitrión las revela.
      allow read: if isAdmin()
        || actividadAbierta('misiones')
        || (tengoIdentidad() && miIdentidad().persona == persona);

      allow create: if tengoIdentidad() && miIdentidad().persona == persona
        && request.resource.data.keys().hasOnly(['misionId', 'texto', 'abiertaEn']);

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // Interrogatorio en vivo (trivia tipo Kahoot) — heredado y sin cambios.
    // Es la parte más probada del sistema; no tocar sin motivo.
    // ─────────────────────────────────────────────────────────────────────

    function gameState() {
      return get(/databases/$(database)/documents/triviaGame/live).data;
    }

    match /triviaGame/live {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lectura pública PERO limitada a la pregunta activa: así nadie se
    // adelanta a leer el resto del banco.
    match /triviaQuestions/{questionId} {
      allow read: if isAdmin() || gameState().currentQuestionId == questionId;
      allow write: if isAdmin();
    }

    // La respuesta correcta vive aquí, aislada: NUNCA legible por un jugador.
    match /triviaKeys/{questionId} {
      allow read, write: if isAdmin();
    }

    // Una respuesta por pregunta y por persona, inmutable.
    match /triviaResponses/{responseId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && responseId == request.resource.data.questionId + '_' + request.auth.uid
        && gameState().status == 'question'
        && gameState().currentQuestionId == request.resource.data.questionId
        && request.resource.data.optionIndex is int
        && request.resource.data.optionIndex >= 0
        && request.resource.data.optionIndex < gameState().optionCount
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'photoURL', 'questionId', 'optionIndex', 'answeredAt']
           );

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /triviaScores/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // La sala de espera: quién está dentro antes de que empiece la trivia.
    //
    // Lectura pública porque la televisión la muestra y no tiene sesión. Cada
    // quien se marca solo a sí mismo —el id del documento es su uid, así que no
    // puede inscribir a nadie más— y puede salirse; el anfitrión además saca a
    // cualquiera, que es cómo se corrige un celular muerto a mitad de ronda.
    match /triviaSala/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'entroEn']);

      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
